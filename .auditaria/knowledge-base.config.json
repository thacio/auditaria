{
  "$version": "1.0.0",
  "config": {
    "database": {
      "backend": "pglite"
    },
    "indexing": {
      "includePaths": [],
      "ignorePaths": [
        "node_modules",
        ".git",
        "dist",
        "build",
        "*.log",
        ".auditaria"
      ],
      "prepareWorkers": 1
    },
    "embeddings": {
      "model": "Xenova/multilingual-e5-small"
    },
    "search": {
      "defaultStrategy": "hybrid",
      "defaultLimit": 10
    },
    "ocr": {
      "enabled": true,
      "defaultLanguages": [
        "en"
      ]
    }
  }
}
